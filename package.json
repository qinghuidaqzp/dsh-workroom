{
  "name": "dsh-workroom",
  "version": "0.1.0",
  "description": "A pixel room in the DeepSeek Harness right sidebar that keeps an eye on your agent: it shows whether sessions are running, waiting for you, done or failed, and its glass knob switches day, dusk and night to set how often the agent asks before acting (ask every step, normal, hands-off).",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "pixel-art", "companion", "status", "approval", "autonomy", "sidebar", "webgl"],
  "license": "MIT",
  "author": "qinghuidaqzp",
  "homepage": "https://github.com/qinghuidaqzp/dsh-workroom#readme",
  "repository": { "type": "git", "url": "git+https://github.com/qinghuidaqzp/dsh-workroom.git" },
  "bugs": { "url": "https://github.com/qinghuidaqzp/dsh-workroom/issues" },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "icon": "./icon.svg",
  "files": ["index.js", "client.js", "lib", "locale", "icon.svg", "cordis.patch.yml", "README.md", "README.en.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web" }
  },
  "engines": { "node": ">=22.12.0", "dsh": ">=0.2.0-0 <0.3.0" },
  "scripts": { "test": "node --test test/*.test.js" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/schemastery": "^3.19.0"
  }
}
